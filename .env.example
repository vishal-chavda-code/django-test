# Django settings — all OPTIONAL.
# The site runs fine without a .env file (safe demo defaults are baked into settings.py).
# Copy this to `.env` only if you want to override defaults.

# Generate a real key for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-real-secret-key-for-production-use-only

# Set False in production
DJANGO_DEBUG=True

# Comma-separated list of hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Streamlit dashboard URLs (used by Django templates to embed iframes).
# Leave as defaults unless you change the streamlit ports.
STREAMLIT_DASHBOARD_1_URL=http://localhost:8501
STREAMLIT_DASHBOARD_2_URL=http://localhost:8502
